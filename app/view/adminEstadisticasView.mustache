<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">

    <title>Estadísticas | Preguntones</title>

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

    <link
            href="/web2-unlam-tp-final/estilos/aplicacion.css"
            rel="stylesheet">
</head>

<body>

{{> components/headerView}}

<main class="container py-5">
    <section class="mb-5">
        <p class="eyebrow mb-2">
            PANEL ADMINISTRATIVO
        </p>
        <h1 class="display-5 fw-bold text-white">
            Estadísticas
        </h1>
        <p class="text-secondary">
            Análisis avanzados de actividad, crecimiento y comportamiento de los usuarios.
        </p>
    </section>

    <div class="card shadow-sm">
        <div class="card-body py-5 text-center">
            <h3>
                Próximamente
            </h3>

            <p class="text-muted mb-4">
                Aquí se mostrarán estadísticas por país, sexo, edad y porcentaje de aciertos.
            </p>

            <a href="{{admin_url}}" class="btn btn-outline-accent">
                Volver al Panel
            </a>
        </div>

    </div>
</main>
{{> components/footerView}}
</body>
</html>