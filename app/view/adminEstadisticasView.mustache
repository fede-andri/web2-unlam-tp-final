<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">
    <title>Estadísticas | Preguntones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/web2-unlam-tp-final/estilos/aplicacion.css" rel="stylesheet">
</head>

<body>
{{> components/headerView}}

<main class="container py-5">
    <section class="mb-5">
        <p class="eyebrow mb-2">
            PANEL ADMINISTRATIVO
        </p>
        <h1 class="display-5 fw-bold text-white">
            Estadísticas
        </h1>
        <p class="text-secondary">
            Distribución y comportamiento de los jugadores de Preguntones.
        </p>
    </section>

    <div class="row g-4">

        <!-- Usuarios por País -->

        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="card-title mb-4">
                        Usuarios por País
                    </h4>
                    {{#paises}}
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <span>
                                {{pais}}
                            </span>
                            <span class="badge bg-success">
                                {{total}}
                            </span>
                        </div>
                    {{/paises}}

                    {{^paises}}
                        <div class="text-muted">
                            No hay información disponible.
                        </div>
                    {{/paises}}
                </div>

            </div>

        </div>


        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-4">
                        Usuarios por Sexo
                    </h4>
                    {{#sexos}}
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <span>
                                {{sexo}}
                            </span>
                            <span class="badge bg-success">
                                {{total}}
                            </span>
                        </div>
                    {{/sexos}}
                    <hr>
                    <div style="height:300px;">
                        {{#hay_datos_sexo}}
                            <canvas id="graficoSexo"></canvas>
                        {{/hay_datos_sexo}}

                        {{^hay_datos_sexo}}
                            <div class="alert alert-secondary">
                                No hay datos suficientes para generar el gráfico.
                            </div>
                        {{/hay_datos_sexo}}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-4">
                        Usuarios por Edad
                    </h4>
                    {{#edades}}
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <span>
                                {{rango}}
                            </span>
                            <span class="badge bg-success">
                                {{total}}
                            </span>
                        </div>
                    {{/edades}}
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h4 class="card-title mb-4">
                        Porcentaje de Aciertos
                    </h4>

                    {{#aciertos}}
                        <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                            <span>
                                {{rango}}
                            </span>
                            <span class="badge bg-success">
                                {{total}}
                            </span>
                        </div>
                    {{/aciertos}}
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5">
        <a href="{{admin_url}}" class="btn btn-outline-accent">
            Volver al Panel
        </a>
    </div>

</main>

{{> components/footerView}}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    const ctxSexo =
            document.getElementById('graficoSexo');

    new Chart(ctxSexo, {

        type: 'doughnut',

        data: {

            labels: {{{sexos_labels_json}}},

            datasets: [{

                data: {{{sexos_datos_json}}},

                backgroundColor: [

                    '#198754',
                    '#20c997',
                    '#0dcaf0',
                    '#6f42c1'

                ]
            }]
        }
    });

</script>
</body>
</html>