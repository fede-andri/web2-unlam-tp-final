<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">
    <title>Sugerir Pregunta | Preguntones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/web2-unlam-tp-final/estilos/aplicacion.css" rel="stylesheet">
</head>
<body class="register-page">

    {{> components/headerView}}

    <main class="auth-wrap">
        <div class="auth-card">

            <section class="auth-aside">
                <div>
                    <div class="aside-mark" aria-hidden="true">✦</div>
                    <p class="eyebrow mb-0">Comunidad</p>
                    <h1 class="aside-title">Proponé tus propios desafíos.</h1>
                    <p class="aside-copy mb-0">Ayudá a expandir el conocimiento de la comunidad sugiriendo nuevas preguntas sobre League of Legends.</p>
                </div>
                <p class="aside-footnote">Las preguntas sugeridas serán revisadas por un editor.</p>
            </section>

            <section class="auth-content">
                <div class="form-shell">
                    <div class="mb-4">
                        <p class="eyebrow mb-0">Colaboración</p>
                        <h2 class="form-title">Sugerir pregunta</h2>
                        <p class="form-intro">Completá los datos y definí las opciones de respuesta.</p>
                    </div>

                    {{#error}}
                        <div class="alert alert-danger mb-4" role="alert">{{error}}</div>
                    {{/error}}

                    {{#success}}
                        <div class="alert alert-success mb-4" role="alert">{{success}}</div>
                    {{/success}}

                    <form method="POST" action="{{guardar_pregunta_url}}">
                        
                        <div class="mb-3">
                            <label for="categoria_id" class="form-label">Categoría</label>
                            <select class="form-control" id="categoria_id" name="categoria_id" required>
                                <option value="">Seleccioná una categoría...</option>
                                {{#categorias}}
                                    <option value="{{id}}">{{nombre}}</option>
                                {{/categorias}}
                            </select>
                        </div>

                        <div class="mb-3">
                            <label for="enunciado" class="form-label">Enunciado de la pregunta</label>
                            <textarea class="form-control" id="enunciado" name="enunciado" rows="3" required placeholder="Ej: ¿Qué objeto otorga velocidad de ataque y crítico?"></textarea>
                        </div>

                        <label class="form-label mb-2">Respuestas (marcá cuál es la correcta)</label>

                        <div class="input-group mb-2">
                            <div class="input-group-text bg-transparent border-secondary text-white">
                                <input class="form-check-input mt-0" type="radio" name="correcta" value="0" required title="Marcar como correcta">
                            </div>
                            <input type="text" class="form-control" name="respuestas[]" placeholder="Opción A" required>
                        </div>

                        <div class="input-group mb-2">
                            <div class="input-group-text bg-transparent border-secondary text-white">
                                <input class="form-check-input mt-0" type="radio" name="correcta" value="1" title="Marcar como correcta">
                            </div>
                            <input type="text" class="form-control" name="respuestas[]" placeholder="Opción B" required>
                        </div>

                        <div class="input-group mb-2">
                            <div class="input-group-text bg-transparent border-secondary text-white">
                                <input class="form-check-input mt-0" type="radio" name="correcta" value="2" title="Marcar como correcta">
                            </div>
                            <input type="text" class="form-control" name="respuestas[]" placeholder="Opción C">
                        </div>

                        <div class="input-group mb-4">
                            <div class="input-group-text bg-transparent border-secondary text-white">
                                <input class="form-check-input mt-0" type="radio" name="correcta" value="3" title="Marcar como correcta">
                            </div>
                            <input type="text" class="form-control" name="respuestas[]" placeholder="Opción D">
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100 mb-2">Enviar sugerencia</button>
                        <a href="{{lobby_url}}" class="btn btn-outline-accent btn-lg w-100">Volver al lobby</a>

                    </form>
                </div>
            </section>

        </div>
    </main>

    {{> components/footerView}}

</body>
</html>
