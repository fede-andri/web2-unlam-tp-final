<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">

    <title>Métricas Generales | Preguntones</title>

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

    <link
            href="/web2-unlam-tp-final/estilos/aplicacion.css"
            rel="stylesheet">
</head>

<body>
{{> components/headerView}}

<main class="container py-5">
    <section class="mb-5">
        <p class="eyebrow mb-2">
            PANEL ADMINISTRATIVO
        </p>
        <h1 class="display-5 fw-bold text-white">
            Métricas Generales
        </h1>
        <p class="text-secondary">
            Información general sobre la actividad y crecimiento de la plataforma.
        </p>
    </section>

    <div class="row g-4">
        <!-- Jugadores -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        Jugadores
                    </h5>
                    <p class="text-muted mb-3">
                        Usuarios registrados en el sistema.
                    </p>
                    <div class="display-4 fw-bold text-success">
                        {{jugadores}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Partidas -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        Partidas
                    </h5>
                    <p class="text-muted mb-3">
                        Total de partidas jugadas.
                    </p>
                    <div class="display-4 fw-bold text-success">
                        {{partidas}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Preguntas -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        Preguntas
                    </h5>
                    <p class="text-muted mb-3">
                        Cantidad total cargada.
                    </p>
                    <div class="display-4 fw-bold text-success">
                        {{preguntas_creadas}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Usuarios Nuevos -->
        <div class="col-md-6 col-xl-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        Nuevos Hoy
                    </h5>
                    <p class="text-muted mb-3">
                        Usuarios registrados hoy.
                    </p>
                    <div class="display-4 fw-bold text-success">
                        {{usuarios_nuevos}}
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-5">
        <a href="{{admin_url}}" class="btn btn-outline-accent">Volver al Panel
        </a>
    </div>
</main>
{{> components/footerView}}
</body>
</html>
