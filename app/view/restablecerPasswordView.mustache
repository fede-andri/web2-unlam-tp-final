<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">

    <title>Restablecer contraseña | Preguntones</title>

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet"
            integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
            crossorigin="anonymous">

    <link
            href="{{base_path_url}}/estilos/aplicacion.css"
            rel="stylesheet">
</head>

<body class="login-page">

{{> components/headerView}}

<main class="auth-wrap">

    <div class="auth-card">

        <section class="auth-aside">

            <div>

                <div class="aside-mark" aria-hidden="true">
                    ✦
                </div>

                <p class="eyebrow mb-0">
                    Preguntones
                </p>

                <h1 class="aside-title">
                    Protegé tu cuenta.
                </h1>

                <p class="aside-copy mb-0">
                    Elegí una nueva contraseña segura para volver a acceder a tu perfil y continuar tu aventura.
                </p>

            </div>

            <p class="aside-footnote">
                Una contraseña segura ayuda a proteger tu progreso.
            </p>

        </section>

        <section class="auth-content">

            <div class="form-shell">

                <div class="mb-4">

                    <p class="eyebrow mb-0">
                        Recuperación de cuenta
                    </p>

                    <h2 class="form-title">
                        Restablecer contraseña
                    </h2>

                    <p class="form-intro">
                        Ingresá una nueva contraseña para tu cuenta.
                    </p>

                </div>

                {{#error}}
                    <div class="alert alert-danger" role="alert">
                        {{error}}
                    </div>
                {{/error}}

                {{#success}}
                    <div class="alert alert-success" role="alert">
                        {{success}}
                    </div>
                {{/success}}

                {{#token}}

                    <form
                            method="POST"
                            action="{{guardar_password_url}}">

                        <input
                                type="hidden"
                                name="token"
                                value="{{token}}">

                        <div class="mb-3">

                            <label
                                    for="password"
                                    class="form-label">

                                Nueva contraseña

                            </label>

                            <input
                                    type="password"
                                    class="form-control"
                                    id="password"
                                    name="password"
                                    placeholder="Ingresá tu nueva contraseña"
                                    autocomplete="new-password"
                                    required>

                        </div>

                        <div class="mb-4">

                            <label
                                    for="confirm_password"
                                    class="form-label">

                                Confirmar contraseña

                            </label>

                            <input
                                    type="password"
                                    class="form-control"
                                    id="confirm_password"
                                    name="confirm_password"
                                    placeholder="Repetí la nueva contraseña"
                                    autocomplete="new-password"
                                    required>

                        </div>

                        <button
                                type="submit"
                                class="btn btn-accent btn-lg w-100">

                            Guardar contraseña

                        </button>

                    </form>

                {{/token}}

                <div class="form-divider">
                    o
                </div>

                <a
                        href="{{login_show_url}}"
                        class="btn btn-outline-accent btn-lg w-100">

                    Volver al inicio de sesión

                </a>

                <p class="form-footer">
                    Sistema de Preguntas y Respuestas
                </p>

            </div>

        </section>

    </div>

</main>

{{> components/footerView}}

</body>
</html>