<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">
    <title>Iniciar sesión | Preguntones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/web2-unlam-tp-final/estilos/aplicacion.css" rel="stylesheet">
</head>
<body class="login-page">
    {{> components/headerView}}

    <main class="auth-wrap">
        <div class="auth-card">
            <section class="auth-aside">
                <div>
                    <div class="aside-mark" aria-hidden="true">✦</div>
                    <p class="eyebrow mb-0">Preguntones</p>
                    <h1 class="aside-title">El saber también es una aventura.</h1>
                    <p class="aside-copy mb-0">Volvé a la comunidad, respondé nuevos desafíos y seguí escalando posiciones.</p>
                </div>
                <p class="aside-footnote">Cada partida suma. ¡Seguí jugando!</p>
            </section>

            <section class="auth-content">
                <div class="form-shell">
                    <div class="mb-4">
                        <p class="eyebrow mb-0">Bienvenido/a</p>
                        <h2 class="form-title">Iniciar sesión</h2>
                        <p class="form-intro">Ingresá tus datos para acceder a tu cuenta.</p>
                    </div>

                    {{#login_error}}
                        <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                            <span class="fw-bold" aria-hidden="true">!</span>
                            <span>El usuario o la contraseña son incorrectos. Revisá tus datos e intentá nuevamente.</span>
                        </div>
                    {{/login_error}}

                    {{#usuario_no_validado}}
                        <div class="alert alert-warning d-flex align-items-start gap-2" role="alert">
                            <span class="fw-bold" aria-hidden="true">!</span>
                            <span> Debés validar tu cuenta desde el correo electrónico antes de iniciar sesión.</span>
                        </div>
                    {{/usuario_no_validado}}

                    {{#registro_exitoso}}
                        <div class="alert alert-success" role="status">
                            Tu cuenta fue creada correctamente. Ya podés iniciar sesión.
                        </div>
                    {{/registro_exitoso}}

                    <form method="POST" action="{{login_url}}">
                        <div class="mb-3">
                            <label for="usuario" class="form-label">Usuario</label>
                            <input
                                type="text"
                                class="form-control"
                                id="usuario"
                                name="usuario"
                                placeholder="Tu nombre de usuario"
                                autocomplete="username"
                                required
                                autofocus
                            >
                        </div>

                        <div class="mb-4">
                            <label for="password" class="form-label">Contraseña</label>
                            <input
                                type="password"
                                class="form-control"
                                id="password"
                                name="password"
                                placeholder="Ingresá tu contraseña"
                                autocomplete="current-password"
                                required
                            >
                        </div>

                        <button type="submit" class="btn btn-accent btn-lg w-100">Ingresar</button>
                        <div class="form-divider">o</div>
                        <a href="{{registro_url}}" class="btn btn-outline-accent btn-lg w-100">Registrarse</a>
                    </form>

                    <p class="form-footer">Sistema de Preguntas y Respuestas</p>
                </div>
            </section>
        </div>
    </main>
    {{> components/footerView}}
</body>
</html>
