<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#091411">

        <title>Recuperar contraseña | Preguntones</title>

        <link
                href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
                rel="stylesheet"
                integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
                crossorigin="anonymous">

        <link
                href="{{base_path_url}}/estilos/aplicacion.css"
                rel="stylesheet">
    </head>

    <body class="login-page">

        {{> components/headerView}}

        <main class="auth-wrap">

            <div class="auth-card">

                <section class="auth-aside">

                    <div>

                        <div class="aside-mark" aria-hidden="true">
                            ✦
                        </div>

                        <p class="eyebrow mb-0">
                            Preguntones
                        </p>

                        <h1 class="aside-title">
                            Recuperá el acceso a tu cuenta.
                        </h1>

                        <p class="aside-copy mb-0">
                            Si olvidaste tu contraseña, te enviaremos un enlace seguro para crear una nueva.
                        </p>

                    </div>

                    <p class="aside-footnote">
                        Tu progreso y tus partidas te están esperando.
                    </p>

                </section>

                <section class="auth-content">

                    <div class="form-shell">

                        <div class="mb-4">

                            <p class="eyebrow mb-0">
                                Recuperación de cuenta
                            </p>

                            <h2 class="form-title">
                                ¿Olvidaste tu contraseña?
                            </h2>

                            <p class="form-intro">
                                Ingresá el correo electrónico asociado a tu cuenta y te enviaremos un enlace para restablecer tu contraseña.
                            </p>

                        </div>

                        {{#error}}
                            <div class="alert alert-danger" role="alert">
                                {{error}}
                            </div>
                        {{/error}}

                        {{#success}}
                            <div class="alert alert-success" role="alert">
                                {{success}}
                            </div>
                        {{/success}}

                        <form
                                method="POST"
                                action="{{enviar_recuperacion_url}}">

                            <div class="mb-4">
                                <label for="email" class="form-label">Correo electrónico</label>
                                <input
                                        type="email"
                                        class="form-control"
                                        id="email"
                                        name="email"
                                        placeholder="Ingresá tu correo electrónico"
                                        autocomplete="email"
                                        required>
                            </div>
                            <button type="submit" class="btn btn-accent btn-lg w-100">Enviar enlace de recuperación</button>
                        </form>

                        <div class="form-divider">o</div>
                        <a href="{{login_show_url}}" class="btn btn-outline-accent btn-lg w-100">Volver al inicio de sesión</a>
                        <p class="form-footer">
                            Sistema de Preguntas y Respuestas
                        </p>
                    </div>
                </section>
            </div>
        </main>
        {{> components/footerView}}
    </body>
</html>