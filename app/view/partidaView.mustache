<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">
    <title>Jugando | Preguntones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="/web2-unlam-tp-final/estilos/aplicacion.css?v=4" rel="stylesheet">
</head>
<body class="game-page" style="--cat: {{categoria_color}}">

{{> components/headerView}}

<main class="game-wrap">

    <div class="game-status">
        <span class="game-score" aria-live="polite">Puntaje <strong>{{puntaje}}</strong></span>
        <span class="game-qnum">Pregunta {{numero_pregunta}}</span>
    </div>

    <section class="game-card" aria-labelledby="pregunta-texto">

        <div class="game-cat-band">
            <span class="game-cat-chip">{{categoria}}</span>
        </div>

        <div class="game-timer" id="game-timer" role="timer" aria-label="Tiempo restante para responder">
            <div class="game-timer-bar" aria-hidden="true"><span id="timer-bar"></span></div>
            <span class="game-timer-text"><span id="timer-text">{{segundos_restantes}}</span> s</span>
        </div>

        <h1 id="pregunta-texto" class="game-question">{{enunciado}}</h1>

        <form method="POST" action="{{responder_url}}" class="game-options" id="form-respuesta">
            {{#opciones}}
                <button type="submit" name="respuesta_id" value="{{id}}" class="game-option">
                    <span class="game-option-letter">{{letra}}</span>
                    <span class="game-option-text">{{texto}}</span>
                </button>
            {{/opciones}}
        </form>

        <p class="game-hint">
            Tenés {{segundos_totales}} segundos por pregunta. Cada respuesta correcta suma un punto.
            Si te equivocás o se acaba el tiempo, la partida termina.
        </p>

    </section>

    <form method="POST" action="{{tiempo_url}}" id="form-tiempo"></form>

</main>

<script>
    (function () {
        var total = {{segundos_totales}} || 1;
        var restantesIniciales = {{segundos_restantes}};

        // El conteo parte de los segundos que calculó el servidor, no de la hora del navegador
        var fin = Date.now() + restantesIniciales * 1000;

        var barra = document.getElementById('timer-bar');
        var texto = document.getElementById('timer-text');
        var temporizador = document.getElementById('game-timer');
        var formRespuesta = document.getElementById('form-respuesta');
        var formTiempo = document.getElementById('form-tiempo');
        var intervalo = null;
        var avisado = false;

        function actualizar() {
            var restante = Math.max(0, Math.ceil((fin - Date.now()) / 1000));

            texto.textContent = restante;
            barra.style.width = Math.min(100, restante / total * 100) + '%';
            temporizador.classList.toggle('is-urgent', restante <= 5);

            if (restante === 0 && !avisado) {
                avisado = true;
                clearInterval(intervalo);
                formRespuesta.classList.add('is-sending');

                // El servidor da 1 segundo de tolerancia: se espera un poco antes de avisar
                setTimeout(function () {
                    formTiempo.submit();
                }, 1200);
            }
        }

        // Al elegir una respuesta se frena el contador y se evitan clics repetidos
        formRespuesta.addEventListener('submit', function () {
            avisado = true;
            clearInterval(intervalo);
            formRespuesta.classList.add('is-sending');
        });

        intervalo = setInterval(actualizar, 250);
        actualizar();
    })();
</script>

</body>
</html>
