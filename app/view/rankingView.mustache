<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f4f7fb">
    <title>Ranking | Preguntones</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <style>
        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at 12% 15%, rgba(13, 110, 253, .09), transparent 28rem),
                #f4f7fb;
        }

        .ranking-card {
            max-width: 1100px;
            overflow: hidden;
            border: 0;
            border-radius: 1.25rem;
            box-shadow: 0 1.5rem 4rem rgba(25, 42, 70, .12);
        }

        .ranking-aside {
            background: linear-gradient(145deg, #123d76, #0d6efd);
        }

        .brand-mark {
            display: grid;
            width: 3rem;
            height: 3rem;
            place-items: center;
            border: 1px solid rgba(255, 255, 255, .3);
            border-radius: .9rem;
            background: rgba(255, 255, 255, .14);
            font-size: 1.35rem;
            font-weight: 700;
        }

        .ranking-table th {
            color: #6c757d;
            font-size: .75rem;
            font-weight: 600;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .ranking-table td {
            padding-top: 1rem;
            padding-bottom: 1rem;
            vertical-align: middle;
        }
    </style>
</head>
<body>
    <main class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
        <div class="card ranking-card w-100">
            <div class="row g-0">
                <section class="col-lg-4 ranking-aside text-white p-4 p-md-5 d-flex flex-column justify-content-between">
                    <div>
                        <div class="brand-mark mb-4" aria-hidden="true">?</div>
                        <p class="text-white-50 text-uppercase small fw-semibold mb-2">Preguntones</p>
                        <h1 class="display-6 fw-bold mb-3">El desafío del conocimiento.</h1>
                        <p class="text-white-50 mb-0">Consultá los puntajes y descubrí quién lidera la comunidad.</p>
                    </div>
                    <p class="small text-white-50 mt-5 mb-0">Cada partida suma. ¡Seguí jugando!</p>
                </section>

                <section class="col-lg-8 p-4 p-md-5">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                        <div>
                            <p class="text-primary fw-semibold small text-uppercase mb-2">Clasificación</p>
                            <h2 class="h3 fw-bold mb-2">Ranking de jugadores</h2>
                            <p class="text-secondary mb-0">Los mejores puntajes de la comunidad.</p>
                        </div>
                        <a href="/web2-unlam-tp-final/" class="btn btn-outline-primary fw-semibold">Volver al inicio</a>
                    </div>

                    {{#hay_jugadores}}
                        <div class="table-responsive">
                            <table class="table ranking-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th scope="col">Posición</th>
                                        <th scope="col">Jugador</th>
                                        <th scope="col" class="text-end">Partidas</th>
                                        <th scope="col" class="text-end">Puntaje</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {{#ranking}}
                                        <tr class="{{#usuario_actual}}table-primary{{/usuario_actual}}">
                                            <td><span class="badge rounded-pill text-bg-light border">#{{posicion}}</span></td>
                                            <td class="fw-semibold">
                                                {{usuario}}
                                                {{#usuario_actual}}<span class="badge text-bg-primary ms-1">Vos</span>{{/usuario_actual}}
                                            </td>
                                            <td class="text-end text-secondary">{{partidas_jugadas}}</td>
                                            <td class="text-end fw-bold text-primary">{{puntaje_total}}</td>
                                        </tr>
                                    {{/ranking}}
                                </tbody>
                            </table>
                        </div>
                    {{/hay_jugadores}}

                    {{^hay_jugadores}}
                        <div class="text-center border rounded-4 bg-light py-5 px-3">
                            <h3 class="h5 fw-bold">Todavía no hay jugadores en el ranking</h3>
                            <p class="text-secondary mb-0">Jugá una partida para inaugurar la clasificación.</p>
                        </div>
                    {{/hay_jugadores}}

                    <p class="text-center text-secondary small mt-4 mb-0">Sistema de Preguntas y Respuestas</p>
                </section>
            </div>
        </div>
    </main>
</body>
</html>
