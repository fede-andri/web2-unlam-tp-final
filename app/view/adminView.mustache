<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#091411">

    <title>Administración | Preguntones</title>

    <link
            href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
            rel="stylesheet">

    <link
            href="/web2-unlam-tp-final/estilos/aplicacion.css"
            rel="stylesheet">
</head>

<body>

{{> components/headerView}}

<main class="container py-5">

    <section class="mb-5">

        <p class="eyebrow mb-2">
            Panel Administrativo
        </p>

        <h1 class="display-5 fw-bold">
            Administración
        </h1>

        <p class="text-muted">
            Gestioná el sistema y visualizá información general de la plataforma.
        </p>

    </section>

    <div class="row g-4">

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Métricas Generales
                    </h5>

                    <p class="card-text">
                        Consultá información sobre usuarios, partidas y preguntas.
                    </p>

                    <span class="badge bg-success">
                        Próximamente
                    </span>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Estadísticas
                    </h5>

                    <p class="card-text">
                        Visualizá el crecimiento y la actividad del sistema.
                    </p>

                    <span class="badge bg-success">
                        Próximamente
                    </span>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-lg-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Administración
                    </h5>

                    <p class="card-text">
                        Herramientas de supervisión y mantenimiento del sistema.
                    </p>

                    <span class="badge bg-success">
                        Próximamente
                    </span>

                </div>

            </div>

        </div>

    </div>

</main>

{{> components/footerView}}

</body>
</html>